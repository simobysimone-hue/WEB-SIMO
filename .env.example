# Variables del servidor de reservas. En Netlify se ponen en:
# Site configuration -> Environment variables. NUNCA en el código.

# Clave secreta de Stripe (Dashboard -> Developers -> API keys)  ej: sk_live_... o sk_test_...
STRIPE_SECRET_KEY=
# Secreto del webhook (Dashboard -> Developers -> Webhooks)
STRIPE_WEBHOOK_SECRET=
# Correo que envía las confirmaciones y su contraseña de aplicación de Google
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Contraseña de la página admin.html (sin ella, el panel no se abre)
ADMIN_PASSWORD=
